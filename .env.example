# ==============================================================================
# THAMILI AI - HUGGING FACE API CONFIGURATION (.env.example)
# ==============================================================================
PORT=3001

# ------------------------------------------------------------------------------
# HUGGING FACE API (Chat Completions & Image Generation)
# Free Access Token from: https://huggingface.co/settings/tokens
# Endpoint for Chat: https://api.huggingface-apis.com/v1/chat/completions
# Supported Chat Models: meta-llama/Llama-2-7b-chat-hf, meta-llama/Meta-Llama-3-8B-Instruct
# Supported Image Models: black-forest-labs/FLUX.1-schnell, black-forest-labs/FLUX.1-dev, stabilityai/stable-diffusion-xl-base-1.0
# ------------------------------------------------------------------------------
HF_TOKEN=
HUGGINGFACE_API_KEY=
HF_CHAT_MODEL=meta-llama/Llama-2-7b-chat-hf

# ------------------------------------------------------------------------------
# Looking for other AI Providers (Gemini, OpenRouter, OpenAI, Stability, Claude,
# Replicate, Together, Groq, Fal.ai, DeepSeek, Mistral, Ollama, etc.)?
# See: .env.providers.example
# ------------------------------------------------------------------------------
