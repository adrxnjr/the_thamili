# ==============================================================================
# THAMILI AI - ALL SUPPORTED AI PROVIDERS CONFIGURATION TEMPLATE
# ==============================================================================
# This file contains configuration keys and endpoints for all supported AI providers.
# Copy any provider settings you wish to use into your active `.env` file.
# ==============================================================================

PORT=3001
PYTHON_API_PORT=8000

# ==============================================================================
# 1. GOOGLE GEMINI (Multimodal, Imagen 3, Gemini Flash & Pro)
# ==============================================================================
# Get your API key at: https://aistudio.google.com/app/apikey
# Docs: https://ai.google.dev/gemini-api/docs
# Supports: Prompt enhancement, Tamil translation, Gemini-2.5-Flash, Imagen-3
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=models/gemini-2.5-flash
GEMINI_IMAGE_MODEL=models/gemini-2.5-flash-image

# ==============================================================================
# 2. OPENROUTER (Universal AI Gateway - 200+ Models with Free Tiers)
# ==============================================================================
# Get your API key at: https://openrouter.ai/keys
# Docs: https://openrouter.ai/docs
# Supports: Free Gemma-4, Llama-3.3-70B, Claude-3.5, GPT-4o, Flux, etc.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct

# ==============================================================================
# 3. HUGGING FACE (Inference API, FLUX.1, SDXL & Open-Source LLMs)
# ==============================================================================
# Get your access token at: https://huggingface.co/settings/tokens
# Docs: https://huggingface.co/docs/api-inference
HF_TOKEN=
HUGGINGFACE_API_KEY=
HF_CHAT_MODEL=meta-llama/Llama-2-7b-chat-hf
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_SDXL_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# ==============================================================================
# 4. OPENAI (DALL·E 3, GPT-4o, GPT-4o-mini)
# ==============================================================================
# Get your API key at: https://platform.openai.com/api-keys
# Docs: https://platform.openai.com/docs/guides/images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ORGANIZATION_ID=

# ==============================================================================
# 5. STABILITY AI (Stable Diffusion 3.5, SDXL, Ultra & Core)
# ==============================================================================
# Get your API key at: https://platform.stability.ai/account/keys
# Docs: https://platform.stability.ai/docs/api-reference
STABILITY_API_KEY=
STABILITY_MODEL=sd3.5-large
STABILITY_OUTPUT_FORMAT=png

# ==============================================================================
# 6. ANTHROPIC (Claude 3.5 Sonnet, Claude 3.5 Haiku - Cultural Intelligence)
# ==============================================================================
# Get your API key at: https://console.anthropic.com/settings/keys
# Docs: https://docs.anthropic.com/claude/reference
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ==============================================================================
# 7. REPLICATE (FLUX.1-dev, FLUX.1-schnell, SDXL, Inpainting & RealESRGAN)
# ==============================================================================
# Get your API token at: https://replicate.com/account/api-tokens
# Docs: https://replicate.com/docs
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan

# ==============================================================================
# 8. TOGETHER AI (Fast FLUX.1 Inference, Llama 3.3, DeepSeek)
# ==============================================================================
# Get your API key at: https://api.together.ai/settings/api-keys
# Docs: https://docs.together.ai/
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
TOGETHER_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ==============================================================================
# 9. GROQ (Ultra-Fast LPUs - Instant Tamil Translation & Prompt Refinement)
# ==============================================================================
# Get your API key at: https://console.groq.com/keys
# Docs: https://console.groq.com/docs/quickstart
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# 10. FAL.AI (Ultra-Low Latency FLUX, Real-Time Image Gen, Inpainting)
# ==============================================================================
# Get your key at: https://fal.ai/dashboard/keys
# Docs: https://fal.ai/docs
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# ==============================================================================
# 11. DEEPSEEK (DeepSeek-V3, DeepSeek-R1 Reasoning & Prompt Structuring)
# ==============================================================================
# Get your API key at: https://platform.deepseek.com/api_keys
# Docs: https://platform.deepseek.com/api-docs
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ==============================================================================
# 12. MISTRAL AI (Mistral Large, Pixtral Vision, Codestral)
# ==============================================================================
# Get your API key at: https://console.mistral.ai/api-keys/
# Docs: https://docs.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ==============================================================================
# 13. COHERE (Command R+, Multilingual Tamil Understanding)
# ==============================================================================
# Get your API key at: https://dashboard.cohere.com/api-keys
# Docs: https://docs.cohere.com/
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# ==============================================================================
# 14. PERPLEXITY AI (Sonar Online Search & Prompt Enrichment)
# ==============================================================================
# Get your API key at: https://www.perplexity.ai/settings/api
# Docs: https://docs.perplexity.ai/
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# ==============================================================================
# 15. CLIPDROP BY STABILITY AI (Background Removal, Upscaling, Uncrop)
# ==============================================================================
# Get your API key at: https://clipdrop.co/apis
# Docs: https://clipdrop.co/apis/docs
CLIPDROP_API_KEY=

# ==============================================================================
# 16. LOCAL & SELF-HOSTED AI (Ollama, LocalAI, ComfyUI, Automatic1111)
# ==============================================================================
# Free local AI without any external API keys
# Docs: https://ollama.com/
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
SD_WEBUI_BASE_URL=http://127.0.0.1:7860
COMFYUI_BASE_URL=http://127.0.0.1:8188
